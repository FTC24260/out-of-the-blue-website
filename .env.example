# ---------------------------------------------------------------------------
# Out Of the Blue · FTC #24260 — environment variables
# Copy this file to `.env` and fill in real values, then restart `npm run dev`.
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the browser.
# ---------------------------------------------------------------------------

# Contact form endpoint.
# Create a free form at https://web3forms.com (use the access key) OR
# https://formspree.io (use the full https://formspree.io/f/xxxx URL).
# If left blank, the contact form runs in DEMO mode (validates + shows a
# success message but does not actually send anything).
VITE_CONTACT_ENDPOINT=

# Donation / "Support Us" URL (e.g. your Biome Robotics donation page or
# a fundraising platform). Opens in a new tab from the Sponsors section.
VITE_DONATE_URL=
